# Frontend environment (Vercel → Project → Settings → Environment Variables).
# Local dev: leave empty (Vite proxies /api to localhost:8000).
# Production: your Render backend URL WITHOUT a trailing slash.
# Set NIRAMAYA_API_URL on Vercel (all other names are legacy fallbacks).
# The value may optionally end with /api. This is a BUILD-TIME variable:
# trigger a NEW deployment after changing it.
NIRAMAYA_API_URL=https://medikiosk-5vjw.onrender.com
# MY_VITE_API_URL=https://medikiosk-5vjw.onrender.com
# VITE_API_URL=https://medikiosk-5vjw.onrender.com
