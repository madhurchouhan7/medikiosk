# Frontend environment (Vercel → Project → Settings → Environment Variables).
# Local dev: leave empty (Vite proxies /api to localhost:8000).
# Production: your Render backend URL WITHOUT a trailing slash.
# VITE_API_URL is preferred (standard Vite prefix); MY_VITE_API_URL is kept
# as a legacy fallback. The value may optionally end with /api.
VITE_API_URL=https://niramaya-backend.onrender.com
# MY_VITE_API_URL=https://niramaya-backend.onrender.com
