# Frontend environment (Vercel → Project → Settings → Environment Variables).
# Local dev: leave empty (Vite proxies /api to localhost:8000).
# Production: your Render backend URL WITHOUT a trailing slash.
# NOTE: Vercel rejects names starting with a framework prefix, so VITE_API_URL
# cannot be created there. Use NIRAMAYA_API_URL on Vercel (preferred).
# MY_VITE_API_URL is kept as a legacy fallback. The value may optionally end
# with /api.
NIRAMAYA_API_URL=https://niramaya-backend.onrender.com
# MY_VITE_API_URL=https://niramaya-backend.onrender.com
