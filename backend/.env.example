# Backend environment (Render → Service → Environment).
# CORS: exact frontend origin(s), comma-separated. Must match your Vercel URL.
FRONTEND_ORIGINS=https://niramaya.vercel.app
# Providers (rule-based local defaults; OCR needs the Tesseract binary,
# which backend/Dockerfile installs — Render's Python runtime does NOT
# include it, so scans are stored for human transcription there).
LLM_PROVIDER=MOCK
STT_PROVIDER=MOCK
OCR_PROVIDER=TESSERACT
# Optional persistent paths (Render free disks are ephemeral; snapshots
# survive restarts but not redeploys unless a paid disk is attached).
NIRAMAYA_DATA_FILE=/data/niramaya_store.json
NIRAMAYA_UPLOADS=/data/uploads
